# Public placeholders only. Actual deployment values belong outside Git.
# Team mode requires explicit configuration; see docs/p2-team-operations.md.
SEMANTIC_STUDIO_MODE=local
SEMANTIC_STUDIO_PUBLIC_ORIGIN=https://studio.example.org
SEMANTIC_STUDIO_GOOGLE_CLIENT_ID=replace-me
SEMANTIC_STUDIO_GOOGLE_CLIENT_SECRET=replace-me
SEMANTIC_STUDIO_ALLOWED_DOMAINS=
SEMANTIC_STUDIO_BOOTSTRAP_SUBS=
SEMANTIC_STUDIO_DATA_DIR=/data/team

# PostgreSQL role secrets are separate files, never inline passwords or DSNs.
TEAM_DB_ADMIN_SECRET_FILE=./secrets/team-admin
TEAM_DB_APP_SECRET_FILE=./secrets/team-app
TEAM_DB_MAINTENANCE_SECRET_FILE=./secrets/team-maintenance
TEAM_DB_BACKUP_SECRET_FILE=./secrets/team-backup
TEAM_DB_SUBNET=172.30.53.0/24
TEAM_DB_GATEWAY=172.30.53.1
TEAM_APP_PORT=8000
# Read-only local-file migration source; leave real deployment data outside Git.
TEAM_LOCAL_SOURCE_DIR=./team-local-source
